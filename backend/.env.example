# Application Configuration
PROJECT_NAME="Student Project Scheduling Tool"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Allowed CORS origins for frontend development
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
# In production or local development, copy this file to .env and fill in your actual credentials.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=student_project_scheduler

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"
